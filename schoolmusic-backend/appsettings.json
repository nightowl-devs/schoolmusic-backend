{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionString": {
    "database": "DATABASE_CONNECTION_STRING_HERE",
    "redis":  "REDIS_CONNECTION_STRING_HERE"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },
  "Features": {
    "SwaggerEnabled": true
  },
  "Jwt": {
    "Issuer": "SchoolMusicAPI",
    "Audience": "SchoolMusicApp",
    "Key": "YOUR_SECRET_KEY_HERE"
  }
}